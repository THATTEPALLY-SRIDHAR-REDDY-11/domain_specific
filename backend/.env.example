# Healthcare RAG Configuration
# Copy this file to .env and fill in your actual API keys

# Groq API (LLM) - Get yours from https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# ChromaDB Configuration (Vector Database)
CHROMA_URL=http://127.0.0.1:8000  # Local Chroma default; use https://api.trychroma.com for cloud
CHROMA_API_KEY=YOUR_CHROMA_API_KEY_HERE  # Optional, for cloud-hosted Chroma
CHROMA_TENANT=YOUR_CHROMA_TENANT_HERE
CHROMA_DATABASE=YOUR_CHROMA_DATABASE_HERE
COLLECTION_NAME=specific-rag  # Collection name (example: healthcare_rag_v1 or specific-rag)

# Frontend (Vite) base URL — set this so the frontend can talk to the backend
# Example: http://localhost:5000/api
VITE_API_BASE=http://localhost:5000/api

# Backend Configuration
PORT=5000
NODE_ENV=development
INGEST_ON_STARTUP=true  # Set to false to start the API without re-indexing every document
